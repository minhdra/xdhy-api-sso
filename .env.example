NODE_ENV=development
PORT=6005

# Origin(s) được phép gọi credentialed tới api-sso trực tiếp (thường chỉ khi
# dev không qua gateway). Prod: mọi request đi qua api-gateway, gateway tự lo
# CORS - để '*' hoặc origin dev cũng được.
CORS_ORIGIN=http://localhost:5173

# api-sso đọc/ghi thẳng build_management (không có DB riêng).
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=build_management
DB_POOL_MAX=5
DB_POOL_MIN=1

# RS256: api-sso là nơi DUY NHẤT giữ private key để ký token. Các service khác
# chỉ cần public key qua JWKS endpoint /.well-known/jwks.json.
# Sinh cặp khoá (đừng commit - thư mục keys/ đã .gitignore):
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
# kid gắn vào header token + JWKS - đổi giá trị này khi xoay khoá.
JWT_KID=dev-1
# Hạn token khi remember=false. remember=true dùng hằng số 1d/30d trong code.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domain cha dùng chung cho cookie (vd .xaydung.vn) - để cookie set bởi api-sso
# đọc được từ build-web/sso-web/chat/meeting cùng domain cha. Rỗng = cookie
# host-only.
COOKIE_DOMAIN=
# Ép Secure=true kể cả khi NODE_ENV=development (vd chạy sau HTTPS proxy /
# OrbStack). Rỗng = tự suy theo NODE_ENV (production -> true).
COOKIE_SECURE=

# Tài khoản gửi email "quên mật khẩu" (nodemailer, Gmail app password).
SYSTEM_EMAIL=
SYSTEM_EMAIL_PASSWORD=
# Link trong email quên mật khẩu trỏ về trang đổi mật khẩu của sso-web.
FRONTEND_RESET_URL=http://localhost:5173/reset-password

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BODY_LIMIT=1mb
