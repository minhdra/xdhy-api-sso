NODE_ENV=development
PORT=6005

# Origin(s) được phép gọi credentialed tới api-sso trực tiếp (thường chỉ khi
# dev không qua gateway). Prod: mọi request đi qua api-gateway, gateway tự lo
# CORS - để '*' hoặc origin dev cũng được.
CORS_ORIGIN=http://localhost:5173

# api-sso đọc/ghi thẳng build_management (không có DB riêng).
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=sso_management
DB_POOL_MAX=5
DB_POOL_MIN=1

# RS256: api-sso là nơi DUY NHẤT giữ private key để ký token. Các service khác
# chỉ cần public key qua JWKS endpoint /.well-known/jwks.json.
# Sinh cặp khoá (đừng commit - thư mục keys/ đã .gitignore):
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
# kid gắn vào header token + JWKS - đổi giá trị này khi xoay khoá.
JWT_KID=dev-1
# Hạn token khi remember=false. remember=true dùng hằng số 1d/30d trong code.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domain cha dùng chung cho cookie (vd .xaydung.vn) - để cookie set bởi api-sso
# đọc được từ build-web/sso-web/chat/meeting cùng domain cha. Rỗng = cookie
# host-only.
COOKIE_DOMAIN=
# Ép Secure=true kể cả khi NODE_ENV=development (vd chạy sau HTTPS proxy /
# OrbStack). Rỗng = tự suy theo NODE_ENV (production -> true).
COOKIE_SECURE=

# Tài khoản gửi email "quên mật khẩu" (nodemailer, Gmail app password).
SYSTEM_EMAIL=
SYSTEM_EMAIL_PASSWORD=
# Link trong email quên mật khẩu trỏ về trang đổi mật khẩu của sso-web.
FRONTEND_RESET_URL=http://localhost:5173/reset-password

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BODY_LIMIT=1mb

# Secret dùng chung cho route nội bộ /internal/* (api-task-management gọi sang
# để hỏi quyền app khi lọc danh sách phân quyền công trình). PHẢI khớp
# SSO_INTERNAL_SECRET bên api-task-management. Sinh: openssl rand -hex 32
INTERNAL_SECRET=

# Gọi api-core sau khi user tự sửa hồ sơ/avatar ở sso-web - api-core lo đồng
# bộ xuống task + chat + meeting. Bỏ trống = tắt (không chặn sửa hồ sơ). CORE_INTERNAL_SECRET
# khớp giá trị cùng tên bên api-core.
CORE_INTERNAL_URL=http://localhost:6001
CORE_INTERNAL_SECRET=

# Dong bo SSO -> app (a_sync_outbox + jobs/syncOutboxJob.ts). Target de trong
# secret = TAT (dung khi app do chay doc lap - STANDALONE_ORG_ADMIN=true ben app).
# finance = api-core, dung CORE_INTERNAL_URL/CORE_INTERNAL_SECRET o tren.
# SYNC_TASK_SECRET phai khop TASK_SYNC_SECRET ben api-task-management.
SYNC_TASK_URL=http://localhost:6002
SYNC_TASK_SECRET=
# chat/meeting: secret header X-Internal-Secret phia do.
SYNC_CHAT_URL=http://localhost:6004
SYNC_CHAT_SECRET=
SYNC_MEETING_URL=http://localhost:6006
SYNC_MEETING_SECRET=
# Tat han target (vd finance khi tai chinh chay doc lap): SYNC_DISABLED_TARGETS=finance
SYNC_DISABLED_TARGETS=
# SYNC_OUTBOX_ENABLED=true
# SYNC_OUTBOX_INTERVAL_MS=5000
# SYNC_OUTBOX_MAX_ATTEMPTS=12

# Render thẻ meta/Open Graph của sso-web từ DB (tab Thương hiệu) - GET /render-page.
# URL NỘI BỘ tới file index.template.html của bản build sso-web, vd
# http://localhost:<port sso-web>/index.template.html (IIS) hoặc
# http://sso-web/index.template.html (docker). Trống = tắt (sso-web dùng index.html tĩnh).
SSO_WEB_TEMPLATE_URL=
# Origin công khai của sso-web cho og:url/og:image - trống = origin của FRONTEND_RESET_URL.
SSO_WEB_PUBLIC_URL=

# Tiền tố tên cookie đăng nhập (access_token/refresh_token). Server dev dùng
# chung domain cha .xdhy.vn với production -> đặt vd dev_ để 2 môi trường không
# ghi đè cookie của nhau. Production để trống. Mọi service (api-sso, api-core,
# api-gateway, api-financial, api-task, chat, meeting) phải đặt CÙNG giá trị.
AUTH_COOKIE_PREFIX=
